{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "schematics": {
    "@schematics/angular:component": {
      "style": "scss",
      "standalone": true,
      "changeDetection": "OnPush"
    },
    "@schematics/angular:directive": {
      "standalone": true
    },
    "@schematics/angular:pipe": {
      "standalone": true
    }
  },
  "cli": {
    "analytics": false
  },
  "projects": {
    "terra-ds": {
      "projectType": "library",
      "root": "projects/terra-ds",
      "sourceRoot": "projects/terra-ds/src",
      "prefix": "lib",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "standalone": true,
          "changeDetection": "OnPush"
        },
        "@schematics/angular:directive": {
          "standalone": true
        },
        "@schematics/angular:pipe": {
          "standalone": true
        }
      },
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/terra-ds/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/terra-ds/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/terra-ds/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "configDir": "projects/terra-ds/.storybook",
            "browserTarget": "terra-ds:build",
            "tsConfig": "projects/terra-ds/.storybook/tsconfig.json",
            "compodoc": true,
            "compodocArgs": [
              "-e",
              "json",
              "-d",
              "projects/terra-ds"
            ],
            "port": 6006
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "configDir": "projects/terra-ds/.storybook",
            "browserTarget": "terra-ds:build",
            "tsConfig": "projects/terra-ds/.storybook/tsconfig.json",
            "compodoc": true,
            "compodocArgs": [
              "-e",
              "json",
              "-d",
              "projects/terra-ds"
            ],
            "outputDir": "storybook-static-terra"
          }
        }
      }
    }
  }
}
