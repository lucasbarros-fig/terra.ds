{
  "name": "terra-ds-workspace",
  "version": "0.0.0.0",
  "scripts": {
    "build": "npm run build:terra-ds",
    "build:terra-ds": "ng build terra-ds --configuration production",
    "build:terra-ds:dev": "ng build terra-ds --configuration development",
    "build:hml": "npm run build:terra-ds",
    "build:prd": "npm run build:terra-ds",
    "storybook": "npm run sync:icon-types && npm run compile:styles && ng run terra-ds:storybook",
    "build-storybook": "npm run sync:icon-types && npm run compile:styles && ng run terra-ds:build-storybook",
    "compile:styles": "node scripts/compile-scss-to-css.js",
    "sync:icon-types": "node scripts/sync-icon-types-from-tokens.js",
    "test": "node scripts/test.cjs",
    "test:unit": "node scripts/test.cjs",
    "test:watch": "npx vitest --config vitest.config.mts",
    "test:coverage": "node scripts/test.cjs --coverage",
    "lint:ts": "eslint \"projects/**/*.ts\"",
    "lint:html": "eslint \"projects/**/*.html\"",
    "lint:scss": "stylelint \"projects/**/*.scss\"",
    "lint": "npm run lint:ts && npm run lint:html && npm run lint:scss",
    "format:check": "prettier --check \"projects/**/*.{ts,html,scss}\""
  },
  "private": true,
  "overrides": {
    "@angular/animations": "$@angular/animations",
    "@angular/cdk": "$@angular/cdk",
    "@angular/common": "$@angular/common",
    "@angular/compiler": "$@angular/compiler",
    "@angular/core": "$@angular/core",
    "@angular/forms": "$@angular/forms",
    "@angular/platform-browser": "$@angular/platform-browser",
    "@angular/platform-browser-dynamic": "$@angular/platform-browser-dynamic",
    "@angular/router": "$@angular/router",
    "rxjs": "$rxjs",
    "tslib": "$tslib",
    "zone.js": "$zone.js"
  },
  "dependencies": {
    "@angular/animations": "~21.2.18",
    "@angular/cdk": "~21.2.14",
    "@angular/common": "~21.2.18",
    "@angular/compiler": "~21.2.18",
    "@angular/core": "~21.2.18",
    "@angular/forms": "~21.2.18",
    "@angular/platform-browser": "~21.2.18",
    "@angular/platform-browser-dynamic": "~21.2.18",
    "@angular/router": "~21.2.18",
    "@teddy-conkey/conkey-ds-tokens": "file:packages/conkey-ds-tokens",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.6.1",
    "@angular-devkit/build-angular": "~21.2.19",
    "@angular/build": "~21.2.19",
    "@angular-eslint/eslint-plugin": "~21.4.0",
    "@angular-eslint/eslint-plugin-template": "~21.4.0",
    "@angular-eslint/template-parser": "~21.4.0",
    "@angular/cli": "~21.2.19",
    "@angular/compiler-cli": "~21.2.18",
    "@compodoc/compodoc": "^1.1.21",
    "@storybook/addon-docs": "^10.5.6",
    "@storybook/addon-links": "^10.5.6",
    "@storybook/angular": "^10.5.6",
    "@types/react-color": "^3.0.6",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@typescript-eslint/utils": "^8.60.1",
    "@vitest/coverage-v8": "^4.0.8",
    "css-loader": "^6.8.1",
    "eslint": "^9.39.4",
    "jsdom": "^25.0.0",
    "ng-packagr": "~21.2.5",
    "ngx-mask": "^21.1.0",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "resolve-url-loader": "^5.0.0",
    "sass": "^1.63.2",
    "sass-loader": "^13.3.1",
    "storybook": "^10.5.6",
    "style-loader": "^3.3.3",
    "stylelint": "^16.26.1",
    "stylelint-config-standard-scss": "^13.1.0",
    "stylelint-scss": "^6.14.0",
    "svgo": "^4.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.0.8"
  }
}
